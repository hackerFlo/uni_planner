# Copy this file to server/.env and fill in real values.
# server/.env is gitignored.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# Optional Gmail SMTP for daily-summary emails (use a Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_ENCRYPT_KEY=replace_me

# Optional local-dev seed account. Leave blank in production.
# When both are set, server/seed.js creates this account on startup if missing.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Set to "true" to allow new account registration. Leave unset to disable signups.
# ALLOW_REGISTER=false
