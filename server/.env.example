# Copy this file to server/.env and fill in real values.
# server/.env is gitignored.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# Optional. nginx serves the SPA and proxies /api on the same origin, so the
# browser never makes a cross-origin request and CORS never engages. Leave it
# unset unless a browser on some other origin must reach the API directly.
# CORS_ORIGIN=https://planner.example.com

# Optional Gmail SMTP for daily-summary emails (use a Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_ENCRYPT_KEY=replace_me

# Optional local-dev seed account. Leave blank in production.
# When both are set, server/seed.js creates this account on startup if missing.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Reverse proxies between the browser and Express, nearest-first.
# 1 = the bundled nginx only (direct LAN, or a single reverse proxy).
# 2 = cloudflared -> nginx  <- use this behind a Cloudflare Tunnel.
# Too low and every visitor shares one rate-limit bucket and HTTPS is not
# detected; too high and clients can spoof their IP via X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Rate limiting is ON by default and fails closed -- it used to switch itself off
# whenever NODE_ENV was not exactly "production", which is a security control
# disappearing without a trace. Set this to "true" ONLY for local development.
# DISABLE_RATE_LIMIT=true

# Leave unset so the session cookie's Secure flag follows the scheme the
# request actually arrived on (HTTPS -> Secure, plain-HTTP LAN -> not Secure).
# Set to "true" to force Secure always, which makes plain-HTTP access refuse
# to log in rather than silently loop.
# COOKIE_SECURE=true

# Set to "true" to allow new account registration. Leave unset to disable signups.
# ALLOW_REGISTER=false

# --- Update checks (optional) -------------------------------------------------
# "owner/repo" whose GitHub Releases the Settings panel checks against. Leave
# unset for local development or a build-from-source deployment: the update
# section then explains that it is not configured instead of failing.
# GITHUB_REPO=example-owner/uni-planner

# Watchtower's HTTP API, reached over the compose network. Nothing is published
# to the host, so this is not an address a browser can use. The default matches
# the service name in docker-compose.nas.yml.
# WATCHTOWER_URL=http://watchtower:8080

# Shared secret for that API. Must equal WATCHTOWER_HTTP_API_TOKEN on the
# watchtower service. Unset means the "Install now" button stays hidden and the
# nightly 04:00 schedule remains the only update path.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# WATCHTOWER_TOKEN=replace_me
